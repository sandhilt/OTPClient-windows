# Include after windows.cmake's deferred target hook. No upstream source edits.
include_guard(GLOBAL)

function(otp_windows_tray_apply target)
    if(NOT WIN32)
        message(FATAL_ERROR "Windows tray substitution requires WIN32")
    endif()
    set(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src")
    get_filename_component(_root "${_root}" ABSOLUTE)
    set(_linux "${_root}/gui/tray.c")
    get_target_property(_sources ${target} SOURCES)
    set(_count 0)
    foreach(_source IN LISTS _sources)
        if(_source STREQUAL _linux)
            math(EXPR _count "${_count} + 1")
        endif()
    endforeach()
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ${_linux} in ${target}; found ${_count}")
    endif()
    list(REMOVE_ITEM _sources "${_linux}")
    set_property(TARGET ${target} PROPERTY SOURCES "${_sources}")
    target_sources(${target} PRIVATE "${_root}/platform/windows/tray-win.c")
    if(ENABLE_MINIMIZE_TO_TRAY)
        target_sources(${target} PRIVATE "${_root}/platform/windows/tray-win-shell.c")
        # Existing windows.cmake uses the plain link signature for app targets.
        target_link_libraries(${target} user32 shell32 gdi32)
    endif()
endfunction()

function(otp_windows_tray_targets)
    if(NOT WIN32)
        return()
    endif()
    if(BUILD_GUI AND TARGET ${PROJECT_NAME})
        otp_windows_tray_apply(${PROJECT_NAME})
    endif()
    if(OTP_WINDOWS_SHIM_CHECKS)
        set(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/platform/windows")
        add_executable(otp-windows-tray-check "${_root}/tray-check.c" "${_root}/tray-win-shell.c")
        target_compile_definitions(otp-windows-tray-check PRIVATE OTP_WINDOWS_TRAY_CHECK)
        target_compile_options(otp-windows-tray-check PRIVATE
            -Wall -Wextra -Werror=format-security -Werror=implicit-function-declaration)
        target_link_libraries(otp-windows-tray-check PRIVATE PkgConfig::GLIB2 user32 shell32 gdi32)
    endif()
endfunction()

cmake_language(DEFER CALL otp_windows_tray_targets)
